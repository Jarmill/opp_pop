classdef opp_manager 
    %OPP_MANAGER Manager for the MATLAB optimal pulse pattern synthesis
    %task
    %
    %based on meas_class/manager_interface, but not totally the same
    %
    %   Detailed explanation goes here
    
    properties
        opts;   %f
        
        sys1;   %storage for the single-phase terms
        sys3;   %storage for the three-phase terms
        sysclock; %storage for the clock terms (in the case of correlative sparsity)

        sdp_settings;
        vars;
    end
    
    methods
        function obj = opp_manager(opts) 
            %OPP_MANAGER storage to run the optimal pulse pattern problem
            %   Detailed explanation goes here
            %
            %opts: opp_options structure

            %break down the options structure
            [obj.opts, obj.sdp_settings] = obj.process_opts(opts);

            % obj.sys3 = opp_diff_current(obj.opts.three_phase == "Floating");
            % obj.sys3 = opp_diff_current_split(obj.opts.three_phase == "Floating");   
            
            
            obj.sys3 = opp_system_3(obj.opts);
            if obj.opts.clock_split
                clock_opts = obj.opts;
                std_opts = obj.opts;
                
                clock_opts.Z_load = 0;
                clock_opts.name= 'clock_';
                std_opts.clock = false;

                
                obj.sys1 = opp_system_1(std_opts);
                obj.sysclock = opp_system_1(clock_opts);
            else
                
                obj.sys1 = opp_system_1(obj.opts);
                obj.sysclock = [];
            end
        end



        %% construct everything

        function [opts_out, sdp_settings]= process_opts(obj, opts)
            opts_out = opts;
            if opts_out.precise
                sdp_settings = sdpsettings('solver','sdpa_gmp',...
                'sdpa_gmp.epsilonStar', 10^(-25), ...
                'sdpa_gmp.epsilonDash', 10^(-25), ...
                'sdpa_gmp.lambdaStar', 10^(4), ...
                'sdpa_gmp.betaStar', 0.1, ...
                'sdpa_gmp.betaBar',0.3, ...
                'sdpa_gmp.gammaStar',0.7,  ...
                'sdpa_gmp.lowerBound',0,  ... %changed lower bound to 0
                'sdpa_gmp.upperBound',10^25,  ...
                'sdpa_gmp.omegaStar',2,  ...
                'sdpa_gmp.maxIteration',200, ... 
                'sdpa_gmp.precision',250);
            else
                sdp_settings = sdpsettings('solver', opts.solver, 'mosek.MSK_DPAR_BASIS_TOL_S', 1e-8, ...
                    'mosek.MSK_DPAR_BASIS_TOL_X', 1e-8, 'mosek.MSK_DPAR_INTPNT_CO_TOL_MU_RED', 1e-9, ...
                    'mosek.MSK_DPAR_INTPNT_TOL_PATH', 1e-6);        
            end

            N = length(opts.L);
            %quarter-wave symmetry starts at 0
            if opts_out.Symmetry==2                
                opts_out.start_level = int32((N+1)/2);
                %if there's an RL load, do quarter-matching
                %track the signal between [0, pi], but impose that the
                %voltage is quarter-wave symmetric
                if (real(opts.Z_load) > 0) && (imag(opts.Z_load) ~= 0)
                    opts_out.quarter_match = true;
                    opts_out.Symmetry=1;
                end
            end            

            %unipolar only if not full-wave symmetric
            if opts_out.Symmetry==0
                opts_out.unipolar = 0;
            end

            %if the start level is declared, then restrict the switching
            %structure
            pulse_length = 2^(-double(opts.Symmetry)) * opts.k;
            if isempty(opts.allowed_levels)
                opts_out.allowed_levels = ones( pulse_length+1, N);
            end

            if opts_out.start_level ~= 0
                for m = 1:pulse_length+1
                    for n = 1:N
                        if (mod(m+n+opts_out.start_level, 2)==0) || (abs(n-opts_out.start_level) > (m-1))
                            opts_out.allowed_levels(m, n) = 0;
                        end
                        
                    end
                end
            end

            if opts_out.Symmetry ~= 0 && opts_out.unipolar
                
                opts_out.allowed_levels(:, 1:((N-1)/2)) = 0;
                        
            end
        end
        

        %% the main routine
        function [sol, obj] = run(obj, order)
            %RUN the main call, the full peak program at the target order
            

            d = 2*order;
            
            %formulate constraints
            tic
            [mom_con, supp_con, len_dual] = obj.cons(d);
                        
            [objective, obj_con] = obj.opp_objective;
            t_prep = toc;
            %solve the program
            sol = obj.solve(objective, mom_con,supp_con);
            sol.preprocess_time = t_prep;
            sol.order = order;
            
            %process dual variables            
            % obj = obj.dual_process(d, sol.dual_rec, len_dual);
        end
        
        %% pose the problem
        function sol = solve(obj, objective, mom_con,supp_con)
            %SOLVE formulate and solve peak estimation program from
            %constraints and objective    
            
            %TODO: incorporate minquery into maximin (minimax) formulation

            mset('yalmip',true, 'verbose', obj.opts.verbose);
            %make sure the solution is precise
            mset(obj.sdp_settings);
            % https://docs.mosek.com/9.2/pythonfusion/parameters.html
            
            
            P = msdp(min(objective), mom_con, supp_con);

            sol = struct;
            tic;
            [sol.status,sol.obj_rec, ~,sol.dual_rec]= msol(P);     
            sol.solver_time = toc;

            if sol.status == 0
                sol.mass = obj.mass_summary();
    
                [~, mom_harm] = obj.sys1.con_harmonics();
                sol.harmonics = double(mom_harm);
            else
                sol.mass = [];
                sol.harmonics = [];
            end
            
        end  

        %% form the constraints
        function [mom_con, supp_con, len_dual] = cons(obj, d)

            %system constraints    
            [con_one, supp_one] = obj.sys1.cons(d);
            [con_three, supp_three] = obj.sys3.cons(d);

            if obj.opts.clock_split
                [con_clock, supp_clock] = obj.sysclock.cons_limited(d);
            else
                con_clock = [];
                supp_clock = [];
            end

            con_align = obj.con_threephase_align(d);

            clock_align = obj.con_clock_align(d);
            % clock_align = [];
            
            % con_align = [];
            % supp_clock = [];

            %with harmonics and dynamics
            mom_con = [con_one; con_three; con_align; clock_align];

            supp_con = [supp_one; supp_three; supp_clock];
            
            %TODO: index the dual variables
            len_dual = 0;

        end

        function three_con = con_threephase_align(obj, d)                   
            %ensure that the inductive current is three-phase balanced
            %
            %figure out if this is possible to do without inductive current
            
            Lmax = max(abs(obj.opts.L));
            if length(obj.sys1.vars.x)>3 && (obj.opts.Z_load ~= 0) ...
                    && ((obj.opts.three_phase ~= opp_three_phase.Ignore) ||...
                (obj.opts.common_mode < Lmax))
                                                             

                %match the measures between the single-phase
                %(switch-constrained) data of (angle, current) and the 
                % three-phase marginal onto the (angle, current in phase a)
                
                init_match = obj.align_init(d);
                term_match = obj.align_term(d);
                occ_match = obj.align_occ(d);
                jump_match = obj.align_jump(d);

                three_con = [occ_match; init_match; term_match; jump_match];
            else
                three_con = [];
            end
        
        end         

        function clock_con = con_clock_align(obj, d)                

            Lmax = max(abs(obj.opts.L));
            if obj.opts.clock && obj.opts.clock_split && (imag(obj.opts.Z_load)~=0)
                                                             

                %match the measures between the single-phase
                %(switch-constrained) data of (angle, current) and the 
                % three-phase marginal onto the (angle, current in phase a)
                
                init_match = obj.align_clock_init(d);
                term_match = obj.align_clock_term(d);
                occ_match = obj.align_clock_occ(d);
                jump_match = obj.align_clock_jump(d);
                % jump_match = [];

                clock_con = [occ_match; init_match; term_match; jump_match];
            else
                clock_con = [];
            end        
        end

        function occ_mom_con = align_occ(obj, d)

            clock_offset = 0 + obj.opts.clock - obj.opts.clock_split;

            if obj.sys3.DYNAMICS
                %separate by levels in phase a
                occ_mom_con = [];

                %just the trig components
                % mom_1 = obj.sys1.sel_occ_monom(d, [1, 2]);                
                % mom_3= obj.sys3.sel_occ_monom(d, [1, 2]);
      

                mom_1 = obj.sys1.sel_occ_monom(d, [1, 2, 3 + clock_offset]);                
                mom_3= obj.sys3.sel_occ_monom(d, [1, 2, 3]);

                % mom_1 = obj.sys1.current_mom(d);
                % mom_3 = obj.sys3.get_I_marginal(d);
                
                if ~iscell(mom_1)
                    occ_mom_con = (mom_1 - mom_3  == 0);
                else
                    for i = 1:length(mom_1)
                        occ_mom_con = [occ_mom_con; mom_1{i} - mom_3{i}==0];
                    end
                end
                % occ_mom_con = [];
                % occ_mom_con = (bmom - mom_3)==0;
            else
                %put all levels together (add them up in phase a)
                bmom_all = obj.current_mom(d);

                bmom = 0;
                for i = 1:length(bmom_all)
                    bmom = bmom + bmom_all{i};
                end
                mom_3 = obj.sys3.get_I_marginal(d);
                % occ_mom_con = (bmom - mom_3)==0;
                occ_mom_con = mom_3==bmom;
            end

            % bmom_all = obj.three_phase_current_mom(d);
            % mom_3 = obj.sys3.get_I_marginals(d);
            % align_occ_set = (bmom_all - mom_3);

            % occ_mom_con = reshape(align_occ_set, [], 1)==0;
            % occ_mom_con = occ_mom_con(:, 1);
        end

        function occ_mom_con = align_clock_occ(obj, d)          
            %separate by levels in phase a
            occ_mom_con = [];

            %just the trig components
            % mom_1 = obj.sys1.sel_occ_monom(d, [1, 2]);                
            % mom_c= obj.sysclock.sel_occ_monom(d, [1, 2]);
             kc = length(obj.sys1.mode);
            [N, P] = size(obj.sys1.mode{1}.levels);
            for m = 1:kc
                for n = 1:N
                    for p = 1:P
                        mom_1 = obj.sys1.mode{m}.levels{n, p}.trig_monom(d);
                        if ~isnumeric(mom_1)
                            mom_c = obj.sysclock.mode{m}.levels{n, p}.trig_monom(d);
                            occ_mom_con = [occ_mom_con; (mom(mom_1) - mom(mom_c))==0];
                        end
                    end
                end
            end

        end

        function init_mom_con = align_init(obj, d)
            %align the initial measure single-three phase
            clock_offset = 0 + obj.opts.clock - obj.opts.clock_split;
            if obj.sys3.DYNAMICS            
                init_1 = obj.sys1.mode{1}.sel_init_monom(d, [1, 2, 3 + clock_offset]);
                init_3 = obj.sys3.sel_init_monom(d, [1, 2, 3]);

                
                %TODO: quarter-wave symmetry will destroy some of this
                init_mom_con = [];
                for i = 1:length(init_1)
                    if ~isnumeric(init_1{i}) || ~isnumeric(init_3{i}) 
                        init_mom_con= [init_mom_con; init_1{i} - init_3{i}==0];
                    end
                end
            else
                init_mom_con = [];
            end
        end

         function init_mom_con = align_clock_init(obj, d)
            %align the initial measure single-three phase                          
            init_1 = obj.sys1.mode{1}.sel_init_monom(d, [1, 2]);
            init_c = obj.sysclock.mode{1}.sel_init_monom(d, [1, 2]);

            
            %TODO: quarter-wave symmetry will destroy some of this
            init_mom_con = [];
            for i = 1:length(init_1)
                if ~isnumeric(init_1{i}) || ~isnumeric(init_c{i}) 
                    init_mom_con= [init_mom_con; init_1{i} - init_c{i}==0];
                end
            end
        
        end


        function term_mom_con = align_term(obj, d)
            %align the terminal measure single-three phase
            clock_offset = 0 + obj.opts.clock - obj.opts.clock_split;
            if obj.sys3.DYNAMICS            
                term_1 = obj.sys1.mode{end}.sel_term_monom(d, [1, 2, 3 + clock_offset]);
                term_3 = obj.sys3.sel_term_monom(d, [1, 2, 3]);

                
                %TODO: quarter-wave symmetry will destroy some of this
                term_mom_con = [];
                for i = 1:length(term_1)
                    if ~isnumeric(term_1{i}) || ~isnumeric(term_3{i}) 
                        term_mom_con= [term_mom_con; term_1{i} - term_3{i}==0];
                    end
                end
            else
                term_mom_con = [];
            end
        end

        function term_mom_con = align_clock_term(obj, d)
            %align the terminal measure single-three phase                 
            term_1 = obj.sys1.mode{end}.sel_term_monom(d, [1, 2]);
            term_c = obj.sysclock.mode{end}.sel_term_monom(d, [1, 2]);

            
            %TODO: quarter-wave symmetry will destroy some of this
            term_mom_con = [];
            for i = 1:length(term_1)
                if ~isnumeric(term_1{i}) || ~isnumeric(term_c{i}) 
                    term_mom_con= [term_mom_con; term_1{i} - term_c{i}==0];
                end
            end

        end
  

        function jump_mom_con = align_jump(obj, d)
            %align the terminal measure single-three phase
            clock_offset = 0 + obj.opts.clock - obj.opts.clock_split;
            if obj.sys3.DYNAMICS            
                [su_1, sd_1] = obj.sys1.sel_jump_monom(d, [1, 2, 3 + clock_offset]);
                [su_3, sd_3] = obj.sys3.sel_jump_monom(d, [1, 2, 3]);

                [NN] = size(su_3, 1);
                %TODO: quarter-wave symmetry will destroy some of this
                jump_mom_con = [];
                for i = 1:NN                   
                    if ~isnumeric(su_1{i}) || ~isnumeric(su_3{i}) 
                        %jump up
                        jump_mom_con= [jump_mom_con; su_1{i} - su_3{i}==0];
                    end
                    
                    if ~isnumeric(sd_1{i}) || ~isnumeric(sd_3{i}) 
                        %jump down
                        jump_mom_con= [jump_mom_con; sd_1{i} - sd_3{i}==0];
                    end
                end
                
            else
                jump_mom_con = [];
            end
        end

        function jump_mom_con = align_clock_jump(obj, d)
            %align the terminal measure single-three phase            
                 
            %this is bugged

            kc = length(obj.sys1.mode);
            [N, P] = size(obj.sys1.mode{1}.levels); 
            jump_mom_con = [];
            for m = 1:kc-1

                [mom_1_up, mom_1_down] = obj.sys1.jumps{m}.sel_monom_jump(d, [1, 2]);
                [mom_c_up, mom_c_down] = obj.sysclock.jumps{m}.sel_monom_jump(d, [1, 2]);
                       
                for n = 1:N-1
                    if ~isnumeric(mom_1_up{n})                            
                        jump_mom_con = [jump_mom_con; (mom_1_up{n}) - (mom_c_up{n})==0];                        
                    end
                    if ~isnumeric(mom_1_down{n})                            
                        jump_mom_con = [jump_mom_con; (mom_1_down{n})-(mom_c_down{n})==0];                        
                    end
                end
                    
            end
        end

            % [su_1, sd_1] = obj.sys1.sel_jump_monom(d, [1, 2]);
            % [su_c, sd_c] = obj.sysclock.sel_jump_monom(d, [1, 2]);
            % 
            % [NN] = size(su_c, 1);
            % %TODO: quarter-wave symmetry will destroy some of this
            % jump_mom_con = [];
            % for i = 1:NN                   
            %     if ~isnumeric(su_1{i}) || ~isnumeric(su_c{i}) 
            %         %jump up
            %         jump_mom_con= [jump_mom_con; su_1{i} - su_c{i}==0];
            %     end
            % 
            %     if ~isnumeric(sd_1{i}) || ~isnumeric(sd_c{i}) 
            %         %jump down
            %         jump_mom_con= [jump_mom_con; sd_1{i} - sd_c{i}==0];
            %     end
            % end
                
           
        


        %% process the objective
        function [objective, obj_con] = opp_objective(obj)
            %OPP_OBJECTIVE Form the objective of the OPP problem
            %
            %Output: 
            % objective: type mom, objective to minimize
            % obj_con:   constraints used to define the objective
            
            %will need to modify this for the three-phase quadratic program
            obj_con = [];
            
            if obj.opts.null_objective
                %for testing only
                % m0 = obj.modes{1}.initial_mass();
                % [~, mass_init_sum] = ones(1, length(obj.opts.L))*m0(:, 1);
                [~, mass_init_sum] = obj.sys1.mode{1}.initial_mass();
                objective = mass_init_sum;
            else
                % objective_jump = 0;
                % for i = 1:length(obj.sys1.jumps)
                %     objective_jump = objective_jump + obj.sys1.jumps{i}.objective();
                % end
                     
                objective_1 = obj.sys1.objective();
                if obj.opts.three_phase == "Floating"
                    %subtract the common-mode contribution
                    objective_3 = obj.sys3.objective();
                else
                    objective_3 = 0;
                end              

                objective = objective_1 + objective_3;
            end

        end

        %% recovery

        function opp_out = recover(obj, sol)
            %process and recover the solution

            % ms = obj.mass_summary();
            pattern_rec = obj.recover_pattern();
            M = obj.mmat();

            bound_lower = sol.obj_rec;
            if obj.opts.Z_load==1.0j
                bound_upper = pattern_rec.energy_I;
            else
                bound_upper = pattern_rec.energy;
            end

            %assuming that the b1 coefficient is pinned
            modulation = obj.opts.harmonics.bound_sin(1);

            
            %impedance function
            kappa = real(obj.opts.Z_load)/(imag(obj.opts.Z_load)*2*pi*obj.opts.f0);
            A_scale = 1/(1+kappa^2);


            bn_lower = sqrt(bound_lower/pi - A_scale*modulation^2);
            bn_upper = sqrt(bound_upper/pi - A_scale*modulation^2);

            opp_out = struct;
            opp_out.pattern = pattern_rec;
            opp_out.M = M;
            opp_out.sol = sol;
            opp_out.energy_lower = bound_lower;
            opp_out.energy_upper = bound_upper;

            opp_out.tdd_lower = bn_lower;            
            opp_out.tdd_upper = bn_upper;
            opp_out.valid_upper = pattern_rec.harm_valid;

            opp_out.opts = obj.opts;
            nmax = 50;
            [opp_out.harm_a, opp_out.harm_b] = pulse_harmonics(nmax, pattern_rec.u, pattern_rec.alpha);
                        
        end

        function [m_out_1, m_out_3] = mmat(obj)
            %get the moment matrix of all measure variables
            m_out_1 = obj.sys1.mmat();            
            m_out_3 = obj.sys3.mmat();
        end


        function [m_out_1, m_out_3] = mmat_corner(obj)
            [m_out_1] = obj.sys1.mmat_corner();
            [m_out_3] = obj.sys3.mmat_corner();
        end

        function [load, load_candidate] = recover_load(obj)
            [load, load_candidate] = obj.sys1.recover_load();
        end

        function [ms1, ms3] = mass_summary(obj)
            ms1 = obj.sys1.mass_summary();
            ms3 = obj.sys3.mass_summary();
        end

        function [pattern] = recover_pattern(obj)
            %RECOVER_PATTERN recover a switching sequence from a solution 
            %(mass of occupation measures)
            %
            %Output: struct pattern
            % occ:      percentage of time spent in each location
            % alpha:    switching angles
            % u:        voltage levels
            % energy:   energy in the switching sequence
            ms = obj.sys1.mass_summary;
            % L = obj.L;
            
            mocc = sum(ms.mode, 3);
            [d, N] = size(mocc);
            

            pattern = struct;
            pattern.occ = mocc;

            %TODO: generalize for other symmetry structures

            %TODO: recovery for early stopping
            [~, ind] = max(mocc, [], 2);
            ang = sum(mocc, 2);                        
            alpha_pre = cumsum(ang(1:end-1));
            u_base = obj.opts.L(ind)';

            pattern.levels = sparse(1:d, ind, ones(1, d));
            switch obj.opts.Symmetry
                case 0
                    alpha_base= 2*pi*alpha_pre;
                    af = alpha_base;
                    uf = u_base;
                case 1
                    alpha_base= pi*alpha_pre;
                    af = [alpha_base; alpha_base + pi];
                    uf = [u_base; -u_base(2:end)];
                case 2
                    alpha_base= (pi/2)*alpha_pre;
                    arev = alpha_base(end:-1:1);
                    af = [alpha_base; pi-arev; pi+alpha_base; 2*pi-arev];
                    uf = [u_base; u_base(end-1:-1:2); -u_base; -u_base(end-1:-1:1)];
            end

            pattern.alpha = af';
            pattern.u = uf';
            pattern.energy = (obj.opts.L(ind).^2)*(2*pi*ang)/(2*pi);


            [I0, Ic] = obj.recover_load();

            % I_val = mom(obj.levels{(length(obj.opts.L)-1)/2+1, 1});
            if imag(obj.opts.Z_load) > 0
                if real(obj.opts.Z_load) > 0
                    kappa = real(obj.opts.Z_load)/imag(obj.opts.Z_load) * (2 * pi * obj.opts.f0); 
                    
                    if (obj.opts.uext)==0
                        outq = pulse_current_voltage_RL(uf, af, 0, 1000, kappa, pi*I0);
                    else
                        I0_send = pi*I0 + abs(obj.opts.uext), angle(obj.opts.uext)
                        outq = pulse_current_voltage_RL_ext(uf, af, 0, 1000, kappa, pi*I0, abs(obj.opts.uext), angle(obj.opts.uext));
                    end
                    pattern.energy_I = outq.energy;
                    pattern.I_val = outq.I_val;
                    pattern.alpha_val = outq.alpha_val;
                    pattern.I = outq.I;
                else
                    uf = pattern.u';
                    ah = [0; pattern.alpha'; 2*pi];               
                    da = diff(ah);
                                %compute the energy in a pure inductor
                    I_step = uf.*da;
                    
                    I_val = cumsum([pi*I0; I_step]);
                    % I_val = I_step + 
                    pattern.I = I_val;
                    energy_raw = 0;
                    for i = 1:length(da)
                        slope = uf(i);
                        offset = I_val(i);
                        prev = ah(i);
                    
                        if slope == 0
                            energy_curr = offset.^2 * (ah(i+1)-ah(i));
                        else
                            pt_end = (offset + slope*(ah(i+1)-prev))^3/(3*slope);
                            pt_start = (offset)^3/(3*slope);
                            energy_curr = pt_end - pt_start;
                        end
                        % energy_raw = energy_raw + energy_curr/(2*pi);
                        energy_raw = energy_raw + energy_curr;
                    end
                    pattern.energy_I = energy_raw;
                end
            else
                pattern.energy_I = 0;
            end

            %harmonics           
            harm_tol = obj.opts.harm_tol;
            [pattern.harmonics, pattern.harm_valid] = pulse_harmonics_evaluate(pattern, obj.opts.harmonics, harm_tol);

            %check if the harmonics are valid

        end

    end
end

