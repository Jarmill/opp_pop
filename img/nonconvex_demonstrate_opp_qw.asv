ylabel('$\alpha_2$', 'interpreter', 'latex')
title(sprintf('$M=%0.1f$, high', M2), 'interpreter', 'latex', 'fontsize', 14)
axis square

function e = pulse_qe(x, y, uq, M)

    [R, S] = size(x);

    Npts = R*S;
    x = reshape(x, [], 1);
    y = reshape(y, [], 1);
    
    e = zeros(Npts, 1);
    for i = 1:Npts
        aq2 = [x(i); y(i)];
        du = diff(uq);
        c3 = (M*pi/(4) - (du(1)*cos(aq2(1)) + du(2)*cos(aq2(2))))/du(3);
        a3 = acos(c3);
        aq = [aq2; a3];
    
        if (c3 >= -1) && (c3 <= 1) && (diff(aq2)>=0) && (a3 >=aq2(end)) && (a3 <= pi/2)
            [outq] = pulse_current_voltage(uq, aq, 2);
            e(i) = outq.energy_I;
        else
            e(i) = NaN;
        end
    end
    e = reshape(e, R, S);
end