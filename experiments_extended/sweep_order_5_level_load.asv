mset clear
yalmip('clear')

RESOLVE = false;

opts = opp_options;
opts.L = [-1, -0.5, 0, 0.5, 1];
opts.harmonics = opp_harmonics();
opts.partition = 2;
opts.TIME_INDEP = true;
opts.early_stop = 0;
opts.null_objective = false;
opts.Symmetry = 1;
opts.unipolar = 1;

opts.k = 24;

modulation = 0.8;
opts.Z_load = 1.0j;
opts.verbose = 0;


opts.harmonics.index_sin= [1;  3];
opts.harmonics.bound_sin = [modulation, modulation; -0.1, 0.1];


%% iterate over the orders
% mlist = 0.05:0.05:1.1;

kappalist = [0, 0.1, 0.5, 1, 2 5];
orderlist = 1:6;
% orderlist = 1:2;
% [mm, kk, kaka] = meshgrid(mlist, klist, kappalist);

% Nm = length(mlist);
% Nk = length(klist);
Nkappa = length(kappalist);
Norder = length(orderlist);

%% now run the experiment


result_std = struct;
result_std.out = cell(Nkappa, Norder);
result_std.tdd_lower= NaN*ones(Nkappa, Norder);
result_std.solver_time  = NaN*ones(Nkappa, Norder);
result_std.preprocess_time  = NaN*ones(Nkappa, Norder);

result_resolve = struct;
result_resolve.out = cell(Nkappa, Norder);
result_resolve.tdd_lower= NaN*ones(Nkappa, Norder);
result_resolve.solver_time  = NaN*ones(Nkappa, Norder);
result_resolve.preprocess_time  = NaN*ones(Nkappa, Norder);

for jj = 1:Nkappa       
    % opts
    if kappalist(jj)==Inf
        opts.Z_load = 0;
    else
        opts.Z_load = kappalist(jj)/(2*pi*opts.f0) + 1.0j;
    end
    MG = opp_manager(opts);
    for i = 1:Norder    
        
        order = orderlist(i); 
        
        sol = MG.run(order);    
        disp(sol)    
        
        %% diagnose the solution
        if sol.status==0
            ms = MG.mass_summary();
            pattern_rec = MG.recover_pattern();
            out = MG.recover(sol);
            result_std.out{i, jj} = out;
        
            % harm_valid = out.pattern.harm_valid;
            result_std.tdd_lower(i, jj) = out.tdd_lower;
            result_std.solver_time(i, jj) = out.sol.solver_time;
            result_std.preprocess_time(i, jj) = out.sol.preprocess_time;
    
            fprintf('unipolar order %d: tdd>=%0.4e', order, out.tdd_lower)
            %solve again.
            if RESOLVE
                opts2 = MG.opts;
                opts2.allowed_levels = out.pattern.levels;
                MG2 = opp_manager(opts2);
                sol2 = MG2.run(order);
                if sol2.status == 0
                    out2 = MG2.recover(sol2);
                    result_resolve.out{i, jj} = out2;
        
                    % harm_valid = out.pattern.harm_valid;
                    result_resolve.tdd_lower(i, jj) = out2.tdd_lower;
                    result_resolve.solver_time(i, jj) = out2.sol.solver_time;
                    result_resolve.preprocess_time(i, jj) = out2.sol.preprocess_time;
                    fprintf('restricted order %d: tdd>=%0.4e', order, out2.tdd_lower)
                    save('order_sweep_5_load_rev.mat','result_std', 'result_resolve')
                end
            end
        end
    end
        
    
    
end
