mset clear
yalmip('clear')

%sweep on pulse length and order
%keep 

RESOLVE = false;

opts = opp_options;
opts.L = [-1, -0.5, 0, 0.5, 1];
opts.harmonics = opp_harmonics();
opts.partition = 1;
opts.TIME_INDEP = true;
opts.early_stop = 0;
opts.null_objective = false;
opts.Symmetry = 1;
opts.unipolar = 1;
opts.quarter_match = 0;

% opts.k = 24;

modulation = 0.8;
kappa = 1;
opts.Z_load = 1.0j + kappa/(2*pi*opts.f0);
opts.verbose = 0;

opts.harmonics.index_sin= [1];
opts.harmonics.bound_sin = [modulation, modulation];

% opts.harmonics.index_sin= [1;  3];
% opts.harmonics.bound_sin = [modulation, modulation; -0.1, 0.1];


%% iterate over the orders
% mlist = 0.05:0.05:1.1;

klist = 4:4:40;
% kappalist = [0, 0.1, 0.5, 1, 2, 5, Inf];
orderlist = 1:6;
% orderlist = 1:2;
% orderlist = 1:5;
% [mm, kk, kaka] = meshgrid(mlist, klist, kappalist);

% Nm = length(mlist);
Nk = length(klist);
Norder = length(orderlist);

%% now run the experiment


result_std = struct;
result_std.out = cell(Nk, Norder);
result_std.tdd_lower= NaN*ones(Nk, Norder);
result_std.solver_time  = NaN*ones(Nk, Norder);
result_std.preprocess_time  = NaN*ones(Nk, Norder);

result_resolve = struct;
result_resolve.out = cell(Nk, Norder);
result_resolve.tdd_lower= NaN*ones(Nk, Norder);
result_resolve.solver_time  = NaN*ones(Nk, Norder);
result_resolve.preprocess_time  = NaN*ones(Nk, Norder);

for jj = 1:Nk
% for jj = 4:4
    % opts
    opts.k = klist(jj);
    MG = opp_manager(opts);
    for i = 1:Norder    
    % for i = 2:2
        
        order = orderlist(i); 
        
        sol = MG.run(order);    
        disp(sol)    
        
        %% diagnose the solution
        if sol.status==0
            ms = MG.mass_summary();
            pattern_rec = MG.recover_pattern();
            out = MG.recover(sol);
            result_std.out{i, jj} = out;
        
            % harm_valid = out.pattern.harm_valid;
            result_std.tdd_lower(i, jj) = out.tdd_lower;
            result_std.solver_time(i, jj) = out.sol.solver_time;
            result_std.preprocess_time(i, jj) = out.sol.preprocess_time;
    
            fprintf('unipolar k=%d, order %d: tdd>=%0.4e', klist(jj), order, out.tdd_lower)
            %solve again.
            if RESOLVE
                opts2 = MG.opts;
                opts2.allowed_levels = out.pattern.levels;
                MG2 = opp_manager(opts2);
                sol2 = MG2.run(order);
                if sol2.status == 0
                    out2 = MG2.recover(sol2);
                    result_resolve.out{i, jj} = out2;
        
                    % harm_valid = out.pattern.harm_valid;
                    result_resolve.tdd_lower(i, jj) = out2.tdd_lower;
                    result_resolve.solver_time(i, jj) = out2.sol.solver_time;
                    result_resolve.preprocess_time(i, jj) = out2.sol.preprocess_time;
                    fprintf('restricted order %d: tdd>=%0.4e \n', order, out2.tdd_lower)
                    save('order_sweep_5_load_k.mat','result_std', 'result_resolve')
                end
            end
        end
    end
        
    
    
end
