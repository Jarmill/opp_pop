N = 1200;
th = linspace(0, 2*pi, N);

% % x = sin(th) + 0.5*cos(3*th);

x = sin(th) - 0.5*sin(5*th) - 0.2*sin(7*th);
% x = sin(th);

K = sqrt(2/3)*[1 -0.5 -0.5;
                0 sqrt(3)/2 -sqrt(3)/2];
        % 

x_opp = circshift(x, N/2);

x_cm2 = (x + x_opp)/2;

xa = x;
xb = circshift(x, N/3);
xc = circshift(x, 2*N/3);
xdiff = K * [xa; xb; xc];

x_cm3 = (xa + xb + xc)/3;

figure(30)
clf
subplot(2, 1, 1)
hold on
plot(th, x, 'LineWidth', 3)
plot(th, x_cm2, 'LineWidth', 3)
plot(th, x_cm3, 'LineWidth', 3)
xlim([0, 2*pi])
xlabel('$\theta$', 'interpreter', 'latex')
ylabel('$x(\theta$', 'interpreter', 'latex')

subplot(2, 1, 2)
plot(th, xdiff, 'LineWidth', 3)

xlim([0, 2*pi])